<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_terminal_glass">

    <!-- 终端标题栏：三色圆点 + 文件名 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_terminal_titlebar"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/error_red"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="●"
            android:textColor="@color/terminal_orange"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="●"
            android:textColor="@color/terminal_green"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="call_log.json"
            android:textColor="#D4D4D4"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnCallLogsCloseX"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_close_circle"
            android:gravity="center"
            android:text="✕"
            android:textColor="#4EC9B0"
            android:textSize="13sp"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 内容区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp">

        <TextView
            android:id="@+id/tvCallLogsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="$ 暂无调用记录"
            android:textColor="@color/terminal_white"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <!-- 底部：清空 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/btnCallLogsClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_terminal_btn"
            android:gravity="center"
            android:padding="9dp"
            android:text="> 清空"
            android:textColor="@color/terminal_orange"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btnCallLogsClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_terminal_btn"
            android:gravity="center"
            android:padding="9dp"
            android:text="> 关闭"
            android:textColor="@color/terminal_orange"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
