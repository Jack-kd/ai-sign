    <!-- 深色：橙色主题 -->
    <style name="Theme.SignAppOrange" parent="Theme.SignApp">
        <item name="colorPrimary">#FFB84D</item>
        <item name="colorPrimaryVariant">#E88A1F</item>
        <item name="signPrimary">#FFB84D</item>
        <item name="signGradientStart">#F0A030</item>
        <item name="signGradientEnd">#C26E16</item>
        <item name="signIconCircle">#33230E</item>
        <item name="signCardStart">#2A2010</item>
        <item name="signCardEnd">#33230E</item>
    </style>
</resources>
