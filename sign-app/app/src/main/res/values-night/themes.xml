<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 深色：蓝色主题（夜间中等亮渐变） -->
    <style name="Theme.SignApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#5A9EFF</item>
        <item name="colorPrimaryVariant">#3B7BD9</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/gradient_start</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="signPrimary">#5A9EFF</item>
        <item name="signGradientStart">#4A8FE8</item>
        <item name="signGradientEnd">#2F6FBE</item>
        <item name="signIconCircle">#1B3A5C</item>
        <item name="signCardStart">#182C44</item>
        <item name="signCardEnd">#1B3A5C</item>
