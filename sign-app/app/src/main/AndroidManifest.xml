<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 网关前台服务：常驻通知保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- service 声明了 foregroundServiceType=dataSync，必须配套该权限，否则 Android 14+ 启动即 SecurityException 闪退 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 常驻通知要显式授权（不授予则通知不显示，服务照常跑） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 唤醒锁：网关灭屏后继续响应请求 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignApp">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AccountDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WorkBuddyAccountDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.QoderCnAccountDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LoomyAccountDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LobsteraiAccountDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".ui.WorkBuddyLoginActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".ui.QoderCnLoginActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".ui.LoomyLoginActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".ui.LobsteraiLoginActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- OpenAI 兼容网关前台服务 -->
        <service
            android:name=".service.GatewayService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
