<?xml version="1.0" encoding="utf-8"?>
<!-- 终端风格弹窗背景：半透明深色调 + 玻璃高光描边 + 圆角（不受日夜主题影响，保持终端隐喻） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F21E293B"
        android:endColor="#CC0D1117" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#334C6FFF" />
</shape>
