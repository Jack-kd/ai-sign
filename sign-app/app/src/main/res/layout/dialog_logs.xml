<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 终端标题栏：三色圆点 + 文件名 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2D2D2D"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/error_red"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="●"
            android:textColor="@color/terminal_orange"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="●"
            android:textColor="@color/terminal_green"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="sign_logs.json"
            android:textColor="#D4D4D4"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <!-- 占位：把 cloud 和 X 推到右侧 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 终端风格关闭：圆框 X -->
        <TextView
            android:id="@+id/btnLogsCloseX"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_close_circle"
            android:gravity="center"
            android:text="✕"
            android:textColor="#4EC9B0"
            android:textSize="13sp"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 本地 / 云端 分段切换（当前模式高亮） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/btnLogsLocalTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_on"
            android:gravity="center"
            android:padding="8dp"
            android:text="本地"
            android:textColor="#4EC9B0"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btnLogsCloudTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_off"
            android:gravity="center"
            android:padding="8dp"
            android:text="云端"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- 终端内容区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="180dp">

        <TextView
            android:id="@+id/tvLogsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="$ 暂无日志"
            android:textColor="@color/terminal_white"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <!-- 底部：单个关闭（点击标题栏的 local/cloud 可切换查看） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/btnLogsClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_terminal_btn"
            android:gravity="center"
            android:padding="9dp"
            android:text="> 关闭"
            android:textColor="@color/terminal_orange"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
