<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_light"
    android:paddingTop="18dp"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🔐 云端凭证加密"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="开启后，上传到 GitHub 的凭证会用 AES-256-GCM 加密；脚本需配置 SIGN_KEY 密钥才能解密签到（未开启则明文上传，无需配置）。"
        android:textColor="@color/gray"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="📖 配置教程"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="1️⃣ 页面上点右上角「New repository secret」
2️⃣ Name 填：SIGN_KEY（注意大写）
3️⃣ Secret 粘贴密钥（先点下方「复制密钥」）→ 点「Add secret」
4️⃣ 回到本页，开启「启用云端凭证加密」"
        android:textColor="@color/gray"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />

    <!-- 一键跳转 GitHub Secrets 页面 -->
    <TextView
        android:id="@+id/btnOpenSecrets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="➡ 打开 GitHub Secrets 页面（去配置 SIGN_KEY）"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/switchCrypto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="启用云端凭证加密"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvCryptoHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/gray"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/tvCryptoKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_terminal_window"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/terminal_green"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCopyKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_gradient"
            android:gravity="center"
            android:padding="11dp"
            android:text="复制密钥"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCryptoClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:padding="11dp"
            android:text="关闭"
            android:textColor="@color/primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
