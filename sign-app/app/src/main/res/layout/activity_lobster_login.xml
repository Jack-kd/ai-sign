<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="登录 LobsterAI"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/signPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="LobsterAI（有道）走浏览器授权登录：点「打开浏览器登录」跳转有道通行证，授权完成后应用会自动拿到凭证并保存，随后同步云端每日签到。\n\n也可以点「粘贴凭证」，把插件里复制的 access_token / refresh_token 直接粘进来。"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/btnOpenBrowser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_gradient"
            android:gravity="center"
            android:padding="14dp"
            android:text="打开浏览器登录"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPasteCred"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_gradient"
            android:gravity="center"
            android:padding="14dp"
            android:text="粘贴凭证"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:background="@color/light_gray"
            android:text="等待操作..."
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/btnCopyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="end"
            android:background="@color/btn_info_bg"
            android:gravity="center"
            android:padding="10dp"
            android:text="复制报错信息"
            android:textColor="@color/btn_info_text"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
