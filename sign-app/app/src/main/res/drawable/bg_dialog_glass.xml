<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗玻璃背景：半透明渐变（高光在上）+ 高光描边 + 24dp 圆角，与主 UI 玻璃卡同语言 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/dialog_glass_start"
        android:endColor="@color/dialog_glass_end" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
