<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_light_rounded"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="⚠️ 登录态失效账号"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvIssuesSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="以下账号凭证已失效，点击即可重新登录"
        android:textColor="@color/gray"
        android:textSize="12sp" />

    <!-- 失效账号列表（代码动态添加，每行一个账号） -->
    <LinearLayout
        android:id="@+id/containerIssues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btnIssuesClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:padding="12dp"
        android:text="关闭"
        android:textColor="?attr/signPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
