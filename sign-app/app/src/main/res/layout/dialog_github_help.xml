<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_light"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🔑 如何获取 GitHub Token"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="◆ 点页面上方的 Generate new token → Generate new token (classic)\n\n◆ Note 随便填（如 ai-sign）；Expiration 选 No expiration（不过期）\n\n◆ Select scopes 列表中勾选：　☑ repo（Full control of private repositories）　☑ workflow（Update GitHub Action workflows）\n\n◆ 点底部绿色 Generate token 按钮\n\n◆ 复制生成的 ghp_... 开头的字符串，粘贴到 App"
        android:textColor="@color/gray"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="⚠️ Token 只显示一次，请妥善保存。"
        android:textColor="@color/warn_text"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnOpenTokens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_gradient"
            android:gravity="center"
            android:padding="12dp"
            android:text="打开 Token 页面"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHelpClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:padding="12dp"
            android:text="关闭"
            android:textColor="?attr/signPrimary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
